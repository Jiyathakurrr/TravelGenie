# ─────────────────────────────────────────────────────────────────────────
# TravelGenie Frontend — Vercel Deployment Environment Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets to Git.
# ─────────────────────────────────────────────────────────────────────────

# ── FRONTEND-ONLY DEPLOYMENT (Vercel) ────────────────────────────────────
# The variables below are safe to set in Vercel dashboard for frontend-only
# deployment. Backend-dependent variables are marked [BACKEND REQUIRED].

# ── Supabase Auth (Required for login/signup to work) ────────────────────
# Public keys — safe to expose in Vercel environment settings
NEXT_PUBLIC_SUPABASE_URL=https://unoipxgakaipffbkpvbg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Render Backend URL [BACKEND REQUIRED — configure after Render deploy] ─
# Leave empty for frontend-only deployment. Backend features will be
# unavailable until the Render Express backend is deployed and this is set.
NEXT_PUBLIC_API_BASE_URL=

# ── Razorpay Public Key [BACKEND REQUIRED — payments need backend] ────────
# Safe to expose (public key only). Payments need backend /api/payment routes.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_TTBCabSxbgE0E6

# ── Cloudinary Public Name [BACKEND REQUIRED — uploads need backend] ──────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# ── GroqCloud AI Key [BACKEND REQUIRED — set on Render, NOT Vercel] ───────
# This is a SECRET key. Must only be set server-side (Render backend).
# DO NOT set GROQ_API_KEY as a NEXT_PUBLIC_ variable on Vercel.
# GROQ_API_KEY=gsk_your_groq_api_key_here  ← Render only, never Vercel frontend
