# --------------------------------------------------------
# TravelGenie Environment Variables Template
# --------------------------------------------------------
# Do not place real secrets in this file.
# Copy this file to .env and populate with actual credentials.

# --------------------------------------------------------
# Application Settings
# --------------------------------------------------------
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --------------------------------------------------------
# Supabase Configuration
# --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --------------------------------------------------------
# Database Configuration
# --------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --------------------------------------------------------
# AI / OpenAI Configuration
# --------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo

# --------------------------------------------------------
# Third-Party Mock Data Paths (For MVP)
# --------------------------------------------------------
MOCK_FLIGHTS_JSON_PATH=./database/mockData/flights.json
MOCK_HOTELS_JSON_PATH=./database/mockData/hotels.json
