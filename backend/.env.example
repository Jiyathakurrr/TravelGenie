# ─────────────────────────────────────────────────────────────
# TravelGenie Express Backend — Render Deployment Environment Template
# Copy to .env for local development — NEVER commit .env to git
# ─────────────────────────────────────────────────────────────

PORT=5000
FRONTEND_URL=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/travelgenie?retryWrites=true&w=majority

# GroqCloud AI Integration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Cloudinary Storage Integration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payments (TEST MODE ONLY)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Authentication Secret
JWT_SECRET=your_secure_jwt_secret_key_here
